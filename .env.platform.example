# Copy to .env.platform and fill in. Never commit real values.
# Generate keys:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                       -> PLATFORM_JWT_SECRET
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"  -> PLATFORM_MASTER_KEY
PLATFORM_JWT_SECRET=
PLATFORM_MASTER_KEY=
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Optional: enables live-LLM drafting and live evals (cost-capped by PLATFORM_EVAL_COST_CAP_USD)
ANTHROPIC_API_KEY=
PLATFORM_LLM_MODEL=claude-opus-5-5
PLATFORM_CORS_ORIGINS=
PLATFORM_LOG_LEVEL=INFO
