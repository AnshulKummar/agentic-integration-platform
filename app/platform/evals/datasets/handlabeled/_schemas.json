      {"path": "properties.state", "type": "string"},
      {"path": "properties.zip", "type": "string"},
      {"path": "properties.country", "type": "string", "format": "country_name", "sample": "United States"},
      {"path": "properties.industry", "type": "string"},
      {"path": "properties.annualrevenue", "type": "number", "format": "decimal"},
      {"path": "properties.numberofemployees", "type": "integer"},
