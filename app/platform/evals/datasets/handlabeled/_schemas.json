{
  "crm-sf/Account": {
    "system": "crm-sf", "kind": "crm", "object": "Account",
    "description": "CRM account record (Salesforce-style naming, custom fields end in __c)",
    "fields": [
      {"path": "Id", "type": "string", "format": "id", "description": "Record id", "sample": "0015g00000AbCdEAAZ"},
      {"path": "Name", "type": "string", "description": "Account name", "sample": "Acme Corp"},
      {"path": "AccountNumber", "type": "string", "description": "Account number"},
      {"path": "Type", "type": "enum", "enum": ["Customer", "Partner", "Prospect"]},
      {"path": "Industry", "type": "string"},
      {"path": "AnnualRevenue", "type": "number", "format": "decimal"},
      {"path": "NumberOfEmployees", "type": "integer"},
      {"path": "Phone", "type": "string", "format": "phone"},
      {"path": "Fax", "type": "string", "format": "phone"},
      {"path": "Website", "type": "string", "sample": "https://acme.example"},
      {"path": "Description", "type": "string"},
      {"path": "BillingStreet", "type": "string", "sample": "1 Market St"},
      {"path": "BillingCity", "type": "string", "sample": "San Francisco"},
      {"path": "BillingState", "type": "string", "sample": "CA"},
      {"path": "BillingPostalCode", "type": "string", "sample": "94105"},
      {"path": "BillingCountry", "type": "string", "format": "country_name", "sample": "United States"},
      {"path": "BillingCountryCode", "type": "string", "format": "country_iso2", "sample": "US"},
      {"path": "ShippingStreet", "type": "string"},
      {"path": "ShippingCity", "type": "string"},
      {"path": "ShippingState", "type": "string"},
      {"path": "ShippingPostalCode", "type": "string"},
      {"path": "ShippingCountry", "type": "string", "format": "country_name"},
      {"path": "ShippingCountryCode", "type": "string", "format": "country_iso2"},
      {"path": "CurrencyIsoCode", "type": "string", "format": "iso4217", "sample": "USD"},
      {"path": "OwnerId", "type": "string", "format": "id", "description": "Owning sales rep (user id)"},
      {"path": "ParentId", "type": "string", "format": "id", "description": "Parent account id"},
      {"path": "CreatedDate", "type": "datetime", "format": "iso8601_datetime"},
      {"path": "LastModifiedDate", "type": "datetime", "format": "iso8601_datetime"},
      {"path": "Tax_ID__c", "type": "string", "description": "Tax / VAT registration number"},
      {"path": "Tax_Exempt__c", "type": "boolean", "description": "Customer holds a tax exemption"},
      {"path": "Payment_Terms__c", "type": "enum", "enum": ["Net 15", "Net 30", "Net 60", "Due on Receipt"]},
      {"path": "Billing_Email__c", "type": "string", "format": "email", "description": "Accounts-payable email for invoices"},
      {"path": "Legacy_Billing_Email__c", "type": "string", "format": "email", "deprecated": true, "description": "Deprecated: use Billing_Email__c"},
      {"path": "Customer_Since__c", "type": "date", "format": "iso8601_date"},
      {"path": "ERP_Customer_ID__c", "type": "string", "description": "Customer id in the ERP"}
    ]
  },
  "crm-sf/Opportunity": {
    "system": "crm-sf", "kind": "crm", "object": "Opportunity",
    "description": "CRM opportunity with parent-account and primary-contact relationship fields (query result)",
    "fields": [
      {"path": "Id", "type": "string", "format": "id", "sample": "0065g00000XyZaBAAV"},
      {"path": "Name", "type": "string", "description": "Opportunity name", "sample": "Acme - Platform renewal 2027"},
      {"path": "AccountId", "type": "string", "format": "id", "description": "Parent account id"},
      {"path": "Account.Name", "type": "string"},
      {"path": "Account.Billing_Email__c", "type": "string", "format": "email"},
      {"path": "Account.BillingStreet", "type": "string"},
      {"path": "Account.BillingCity", "type": "string"},
      {"path": "Account.BillingState", "type": "string"},
      {"path": "Account.BillingPostalCode", "type": "string"},
      {"path": "Account.BillingCountryCode", "type": "string", "format": "country_iso2"},
      {"path": "Account.ShippingStreet", "type": "string"},
      {"path": "Account.ShippingCity", "type": "string"},
      {"path": "Account.ShippingState", "type": "string"},
      {"path": "Account.ShippingPostalCode", "type": "string"},
      {"path": "Account.ShippingCountryCode", "type": "string", "format": "country_iso2"},
      {"path": "Amount", "type": "number", "format": "decimal", "sample": 48000.0},
      {"path": "ExpectedRevenue", "type": "number", "format": "decimal", "description": "Amount x probability"},
      {"path": "Probability", "type": "number", "format": "percent"},
      {"path": "TotalOpportunityQuantity", "type": "number", "description": "Total quantity of products"},
      {"path": "Discount__c", "type": "number", "format": "decimal"},
      {"path": "CloseDate", "type": "date", "format": "iso8601_date", "sample": "2026-11-30"},
      {"path": "StageName", "type": "enum", "enum": ["Prospecting", "Negotiation", "Closed Won", "Closed Lost"]},
      {"path": "Type", "type": "enum", "enum": ["New Business", "Renewal", "Upsell"]},
      {"path": "LeadSource", "type": "string"},
      {"path": "NextStep", "type": "string"},
      {"path": "Description", "type": "string"},
      {"path": "CurrencyIsoCode", "type": "string", "format": "iso4217"},
      {"path": "IsClosed", "type": "boolean"},
      {"path": "IsWon", "type": "boolean"},
      {"path": "OwnerId", "type": "string", "format": "id"},
      {"path": "Owner.Name", "type": "string"},
      {"path": "Owner.Email", "type": "string", "format": "email"},
      {"path": "CreatedDate", "type": "datetime", "format": "iso8601_datetime"},
      {"path": "LastModifiedDate", "type": "datetime", "format": "iso8601_datetime"},
      {"path": "Contract_Start_Date__c", "type": "date", "format": "iso8601_date"},
      {"path": "Contract_Term_Months__c", "type": "integer"},
      {"path": "Payment_Terms__c", "type": "enum", "enum": ["Net 15", "Net 30", "Net 60", "Due on Receipt"]},
      {"path": "PO_Number__c", "type": "string", "description": "Customer purchase-order number"},
      {"path": "Primary_Contact__r.Name", "type": "string"},
      {"path": "Primary_Contact__r.FirstName", "type": "string"},
      {"path": "Primary_Contact__r.LastName", "type": "string"},
      {"path": "Primary_Contact__r.Email", "type": "string", "format": "email"},
      {"path": "Envelope_Id__c", "type": "string", "description": "e-signature envelope id"},
      {"path": "Signature_Status__c", "type": "enum", "enum": ["Not Sent", "Sent", "Signed", "Declined", "Voided"]},
      {"path": "Is_Signed__c", "type": "boolean"},
      {"path": "Signed_Date__c", "type": "date", "format": "iso8601_date"},
      {"path": "Envelope_Sent_Date__c", "type": "date", "format": "iso8601_date"},
      {"path": "Signer_Email__c", "type": "string", "format": "email"},
      {"path": "Signed_Document_URL__c", "type": "string"},
      {"path": "Last_Signature_Sync__c", "type": "datetime", "format": "iso8601_datetime", "description": "When the integration last synced signature data"}
    ]
  },
  "crm-sf/Contact": {
