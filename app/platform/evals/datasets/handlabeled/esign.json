[
  {
    "id": "hl-sf-opportunity-to-ds-envelope",
    "source": "crm-sf/Opportunity", "target": "esign-ds/envelope",
    "sequence": "hl-crm-esign", "step": 1,
    "tags": {"difficulty": "medium", "category": "contract", "vendor_family": "salesforce-style->docusign-style"},
    "notes": "Send the contract to the primary contact; the opportunity owner is copied.",
    "gold": [
      {"target": "emailSubject", "source": "Name", "transform": "concat"},
      {"target": "recipients.signers[].email", "source": "Primary_Contact__r.Email"},
      {"target": "recipients.signers[].name", "source": "Primary_Contact__r.Name"},
      {"target": "recipients.carbonCopies[].email", "source": "Owner.Email"},
      {"target": "recipients.carbonCopies[].name", "source": "Owner.Name"},
      {"target": "customFields.textCustomFields[].value", "source": "Id"},
      {"target": "recipients.signers[].routingOrder", "source": null},
      {"target": "templateId", "source": null},
      {"target": "status", "source": null},
      {"target": "emailBlurb", "source": null},
      {"target": "expirations.expireAfter", "source": null},
      {"target": "envelopeId", "source": null}
    ]
  },
  {
    "id": "hl-ds-envelope-to-sf-opportunity",
    "source": "esign-ds/envelope", "target": "crm-sf/Opportunity",
    "sequence": "hl-crm-esign", "step": 2,
    "tags": {"difficulty": "medium", "category": "contract", "vendor_family": "docusign-style->salesforce-style"},
    "notes": "Signature status write-back on envelope events.",
    "gold": [
      {"target": "Envelope_Id__c", "source": "envelopeId"},
      {"target": "Signature_Status__c", "source": "status", "transform": "enum_map"},
      {"target": "Is_Signed__c", "source": "status", "transform": "enum_map"},
      {"target": "Signed_Date__c", "source": "completedDateTime", "transform": "date_format"},
      {"target": "Envelope_Sent_Date__c", "source": "sentDateTime", "transform": "date_format"},
      {"target": "Signer_Email__c", "source": "recipients.signers[].email", "transform": "first_item"},
      {"target": "Signed_Document_URL__c", "source": "documentsUri"},
      {"target": "Last_Signature_Sync__c", "source": null}
    ]
  },
  {
    "id": "hl-hs-deal-to-ds-envelope",
    "source": "crm-hs/Deal", "target": "esign-ds/envelope",
    "sequence": "hl-crm-esign", "step": 3,
    "tags": {"difficulty": "hard", "category": "contract", "vendor_family": "hubspot-style->docusign-style"},
    "notes": "Owner name/email must be resolved from the owner id.",
    "gold": [
      {"target": "emailSubject", "source": "properties.dealname", "transform": "concat"},
      {"target": "recipients.signers[].email", "source": "properties.primary_contact_email"},
      {"target": "recipients.signers[].name", "source": "properties.primary_contact_name"},
      {"target": "recipients.carbonCopies[].email", "source": "properties.hubspot_owner_id", "transform": "lookup"},
      {"target": "recipients.carbonCopies[].name", "source": "properties.hubspot_owner_id", "transform": "lookup"},
      {"target": "customFields.textCustomFields[].value", "source": "id"},
      {"target": "templateId", "source": null},
      {"target": "status", "source": null},
      {"target": "emailBlurb", "source": null},
      {"target": "envelopeId", "source": null},
      {"target": "recipients.signers[].routingOrder", "source": null}
    ]
  },
  {
