      {"target": "tax_id_data[].value", "source": "formData.tax_id"},
      {"target": "metadata.crm_account_id", "source": null},
      {"target": "phone", "source": null},
      {"target": "shipping.address.city", "source": null},
      {"target": "tax_exempt", "source": null},
      {"target": "preferred_locales[]", "source": null},
      {"target": "id", "source": null}
