    "Account.currency": {
      "format": "currency_display_name"
    },
    "Opportunity.amount": {
      "format": "decimal"
    },
    "Opportunity.payment_terms": {
      "format": "free_text"
    },
    "Contact.email": {
      "format": "email",
      "pii": true
    },
    "Customer.legal_name": {
      "format": "text"
    },
    "Customer.address": {
      "format": "postal_address"
    },
    "Customer.currency_code": {
      "format": "iso4217",
      "constraint": "pattern ^[A-Z]{3}$"
    },
    "Customer.terms_code": {
      "format": "terms_code",
      "constraint": "enum NET15|NET30|NET60|DUE_ON_RECEIPT"
    },
    "Invoice.total": {
      "format": "decimal",
      "defaultTransform": "+ tax"
    },
    "TaxQuote.jurisdiction": {
      "format": "region_code"
    },
    "TaxQuote.amount": {
      "format": "decimal"
    },
    "Agreement.signers[].email": {
      "format": "email",
      "pii": true
    },
    "Agreement.fields.amount": {
      "format": "decimal"
    },
    "Agreement.fields.payment_terms": {
      "format": "free_text"
    }
  },
